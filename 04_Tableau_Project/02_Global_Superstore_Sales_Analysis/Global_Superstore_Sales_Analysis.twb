      <aliases enabled='yes' />
      <column caption='OverAll Discount' datatype='real' name='[Calculation_1250480572141568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]-[Shipping Cost]' />
      </column>
      <column caption='Net Amount' datatype='real' name='[Calculation_1250480579928066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])-SUM([Profit])' />
      </column>
      <column caption='Order_category' datatype='string' name='[Calculation_2349990090903556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales]&gt;= 3000 THEN &quot;HIgh_value&quot;&#13;&#10;ELSEIF [Sales] &gt;= 2000 and [Sales] &lt; 3000 THEN &quot;Mid_value&quot;&#13;&#10;ELSE &quot;low value&quot; END' />
      </column>
      <column caption='Avg_selling_Price' datatype='real' name='[Calculation_2349990093316102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]/[Quantity]' />
      </column>
      <column caption='Order_category_2' datatype='string' name='[Calculation_2349990093557767]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt;= 3000 THEN &quot;High_Value&quot; &#13;&#10;ELSEIF [Sales] &gt;= 2000 AND [Sales] &lt; 3000 THEN &quot;Mid_Value&quot;&#13;&#10;ELSE &quot;Low_Value&quot; END' />
      </column>
      <column caption='Frist_name' datatype='string' name='[Calculation_2349990095007752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Customer Name], FIND([Customer Name],&quot; &quot;,1) -1)' />
      </column>
      <column caption='Running_Total' datatype='real' name='[Calculation_2349990102446089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
