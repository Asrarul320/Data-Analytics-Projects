      <column caption='% Of Total PHEV Vehicles' datatype='real' name='[% Of Total BEV Vehicles (copy)_1670217403342853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total BEV Vehicle (copy)_1670217403006980]/[Calculation_1670217390718976]' />
      </column>
      <column caption='Total Vehicles' datatype='integer' name='[Calculation_1670217390718976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([DOL Vehicle ID])' />
      </column>
      <column caption='Total BEV Vehicle' datatype='integer' name='[Calculation_1670217398607874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF ([Electric Vehicle Type])=&quot;Battery Electric Vehicle (BEV)&quot;&#13;&#10;THEN [DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
